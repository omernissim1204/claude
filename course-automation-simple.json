    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_CLAUDE_API_KEY_HERE"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5-20250929\",\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"document\",\n          \"source\": {\n            \"type\": \"base64\",\n            \"media_type\": \"application/pdf\",\n            \"data\": \"{{ $binary.data.data }}\"\n          }\n        },\n        {\n          \"type\": \"text\",\n          \"text\": \"אני רוצה להכין אינפוגרפיקות שיעזור לי להציג את התוכן של הסיכום הזה. תן לי רשימה של דברים שמגיעה להם אינפוגרפיקה. אל תגיד לי איך לעצב אלא רק את התאוריות, שיטות, מושגים, קבוצות של מושגים, השוואות בין מושגים דומים, פעולה מוסימת שחשוב ללמוד או כל דבר שנראה לך רלוונטי. תכין בין 40 ל60, לפי הצורך בעינייך.\\n\\nהחזר רשימה ממוספרת, כל נושא בשורה נפרדת.\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
