        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "✅ ניתוח הושלם!\n\n📝 מתחיל ליצור שאלות ופרומפטים...\n\nעוד כמה דקות!",
        "additionalFields": {}
      },
      "id": "notify-analysis-done",
      "name": "Notify Analysis Done",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_CLAUDE_API_KEY_HERE"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5-20250929\",\n  \"max_tokens\": 16000,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"רשימת נושאים:\\n{{ $json.topics_text }}\\n\\n---\\n\\nאתה מומחה להוראה אקדמית, בניית הערכה ולמידה מבוססת הבנה. המטרה שלך היא ליצור 50 שאלות אמריקאיות שמלמדות.\\n\\nהקלט: רשימת נושאים לימודיים. עליך להתבסס אך ורק על הטקסט שניתן.\\n\\nעקרונות:\\n- השאלה חייבת לבדוק הבנה מושגית, לא שינון\\n- תיאורית והקשרית\\n- 4 אפשרויות סבירות\\n- אפשרויות שגויות מייצגות בלבול נפוץ\\n- תשובה נכונה אחת\\n- הסבר מלמד\\n\\nפורמט:\\nהחזר JSON array עם 50 אובייקטים:\\n[\\n  {\\n    \\\"question\\\": \\\"...\\\",\\n    \\\"options\\\": [\\\"א\\\", \\\"ב\\\", \\\"ג\\\", \\\"ד\\\"],\\n    \\\"correct_answer\\\": \\\"ב\\\",\\n    \\\"explanation\\\": \\\"...\\\"\\n  }\\n]\\n\\nרק JSON, ללא טקסט נוסף.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "generate-questions",
      "name": "Claude: Generate Questions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "YOUR_CLAUDE_API_KEY_HERE"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5-20250929\",\n  \"max_tokens\": 16000,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"רשימת נושאים:\\n{{ $json.topics_text }}\\n\\n---\\n\\nאתה עורך תוכן לימודי ומומחה לפרומטים ליצירת אינפוגרפיקות.\\n\\nחשוב: המודל ליצירת תמונות לא רואה את החומר המקורי. כל אינפוגרפיקה חייבת להתבסס על הפרומט בלבד.\\n\\nעבור כל נושא:\\n- צור פרומט אחד\\n- הכלל את כל הטקסט שיופיע באינפוגרפיקה\\n\\nמבנה:\\nCanvas & Layout: Vertical 9:16, educational social media story\\nHeadline: כותרת 3-6 מילים\\nMain Content: הגדרה + מאפיינים (אם מושג בודד) או שתי עמודות (אם השוואה)\\nClarification Line: חידוד מושגי\\nVisual Elements: flat icons, תרשימים\\nStyle: Educational infographic, flat design, אקדמי\\n\\nפורמט פלט:\\n=== PROMPT ===\\n[פרומט מלא כאן]\\n\\n=== PROMPT ===\\n[פרומט הבא]\\n\\nרק הפרומפטים, ללא טקסט נוסף.\"\n    }\n  ]\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "generate-prompts",
      "name": "Claude: Generate Infographic Prompts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 400]
    },
    {
      "parameters": {
        "jsCode": "// Parse questions from Claude\nconst responseText = $input.item.json.content[0].text;\nconst courseId = $('Set Context').first().json.course_id;\n\n// Extract JSON\nlet questions;\ntry {\n  const jsonMatch = responseText.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\n  questions = JSON.parse(jsonMatch ? jsonMatch[0] : responseText);\n} catch (e) {\n  console.error('Parse error:', e);\n  return [];\n}\n\n// Format for Supabase\nreturn questions.map(q => {\n  const options = q.options.map((text, i) => ({\n    id: String.fromCharCode(65 + i),\n    text: text,\n    isCorrect: text === q.correct_answer || q.options.indexOf(q.correct_answer) === i\n  }));\n  \n  return {\n    course_id: courseId,\n    question: q.question,\n    options: options,\n    explanation: q.explanation || '',\n    difficulty: 'medium'\n  };\n});"
      },
      "id": "parse-questions",
      "name": "Parse Questions JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 200]
    },
    {
      "parameters": {
        "jsCode": "// Split prompts\nconst responseText = $input.item.json.content[0].text;\nconst courseId = $('Set Context').first().json.course_id;\n\nconst prompts = responseText\n  .split('=== PROMPT ===')\n  .map(p => p.trim())\n  .filter(p => p.length > 100);\n\nreturn prompts.map((prompt, i) => ({\n  prompt: prompt,\n  course_id: courseId,\n  index: i + 1,\n  filename: `infographic_${i + 1}.png`\n}));"
      },
      "id": "split-prompts",
      "name": "Split Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 400]
    },
