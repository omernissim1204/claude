{
  "name": "Course Automation - PDF to Questions & Infographics",
  "nodes": [
    {
      "parameters": {
        "authentication": "none",
        "content": "=📚 **Course Automation Bot**\n\nשלח לי PDF עם caption שמכיל את שם הקורס.\n\nדוגמה:\n`/course psychopathology`\n\nאו פשוט שלח PDF ואני אזהה את הנושא אוטומטית!",
        "respondWith": "text",
        "options": {}
      },
      "id": "start-command",
      "name": "Start Command Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 180]
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {
          "download": false
        }
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": ""
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "combineOperation": "any"
          },
          "conditions": [
            {
              "id": "pdf-check",
              "leftValue": "={{ $json.message.document?.mime_type }}",
              "rightValue": "application/pdf",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "check-if-pdf",
      "name": "Check if PDF",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract course name from caption or filename\nconst message = $input.item.json.message;\nconst caption = message.caption || '';\nconst filename = message.document?.file_name || '';\n\n// Try to extract from caption\nlet courseName = '';\n\nif (caption.startsWith('/course ')) {\n  courseName = caption.replace('/course ', '').trim();\n} else if (caption.length > 0) {\n  courseName = caption;\n} else {\n  // Extract from filename (remove .pdf and clean)\n  courseName = filename.replace('.pdf', '').replace(/[^a-zA-Z0-9_\\u0590-\\u05FF]/g, '_');\n}\n\n// Clean course name\ncourseName = courseName.toLowerCase().trim().replace(/\\s+/g, '_');\n\nreturn {\n  course_id: courseName,\n  display_name: courseName,\n  file_id: message.document.file_id,\n  file_name: message.document.file_name,\n  chat_id: message.chat.id,\n  auto_detected: caption.length === 0\n};"
      },
      "id": "extract-course-info",
      "name": "Extract Course Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "=📄 קיבלתי את הקובץ!\n\n🎓 קורס: **{{ $json.course_id }}**\n{{ $json.auto_detected ? '(זיהוי אוטומטי מהקובץ)' : '' }}\n\n⚙️ מתחיל עיבוד... זה ייקח 10-15 דקות.",
        "additionalFields": {}
      },
